# Copy to .env.local (gitignored) and fill in. `make run-local` sources it.

# Optional but advised: raises GitHub's API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Disclosure mail. Unset SMTP_ADDR logs mail instead of sending it.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification); SMTP_FROM must be the same Gmail address.
SMTP_ADDR=smtp.gmail.com:587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM="GitScanner <you@gmail.com>"

# Who is writing, shown in the mail so the recipient can look you up.
DISCLOSURE_PROJECT="GitScanner, a community secret-scanning project"
DISCLOSURE_SIGNATURE="-- Your Name"
DISCLOSURE_INFO_URL=

# Optional. Lets Settings > Safety masking show the full credentials found in
# repositories of owners you add to the unmask list (your own accounts only).
# Without it nothing is ever kept or shown unmasked. Generate: openssl rand -hex 32
SECRET_SEAL_KEY=

# Optional. Enables "Ask Claude" in the dashboard's command palette, which turns
# a question in plain words into a findings filter (model claude-opus-5-5). Only
# the question and the list of filter values are sent; a question that looks
# like it contains a credential is refused before any call. Without it the
# command is not offered.
ANTHROPIC_API_KEY=
